# Learn Unreal Engine 5 - ignore rules for the course repo and every project/chNN snapshot.
# Patterns without a leading slash match at any depth.

# Unreal Engine generated folders (rebuilt by the editor, UBT and the cooker)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.idea/
.vscode/

# Build/ holds staging output; keep only platform icons and splash images
Build/*
!Build/*/
Build/*/**
!Build/**/*.ico
!Build/**/*.png
!Build/**/*.bmp

# Placeholder art generated by Tools/make_placeholder_art.py
RawAssets/

# Packaged builds: package into a folder named Packaged/ (or anywhere outside the repo)
Packaged/

# IDE and project files (regenerate with "Generate project files")
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace
*.user
*.DotSettings.user

# Compiled output
*.pdb
*.obj
*.exe
*.dll
*.ilk
*.exp
*.lib
*.a
*.o
*.so
*.dylib
*.dSYM/
*.ipa
*.apk

# Python
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
